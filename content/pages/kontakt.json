  "breadcrumb": "Kontakt",
  "body": "<section class=\"container hub-hero\">\n    <p class=\"eyebrow\">Kontakt</p>\n    <h1 class=\"h1\">Po Twojej stronie jest tylko telefon. <span class=\"accent\">Resztę zostaw nam.</span></h1>\n    <p class=\"hub-sub\">Powiedz, czego potrzebujesz. Oddzwaniamy w ciągu 24 godzin. Wycena darmowa, bez zobowiązań.</p>\n  </section>\n\n  <section class=\"section\">\n    <div class=\"container\">\n      <div class=\"contact-cards-grid\">\n\n        <div class=\"contact-card contact-card-primary\">\n          <div class=\"contact-icon\"><svg width=\"36\" height=\"36\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0122 16.92z\"/></svg></div>\n          <div class=\"contact-label\">Zadzwoń</div>\n          <a href=\"tel:+48509508210\" class=\"contact-value contact-phone-link\">+48 509 508 210</a>\n          <a href=\"tel:+48509508110\" class=\"contact-value contact-phone-link\">+48 509 508 110</a>\n        </div>\n\n        <a href=\"mailto:kontakt@stago.com.pl\" class=\"contact-card\">\n          <div class=\"contact-icon\"><svg width=\"36\" height=\"36\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z\"/><polyline points=\"22,6 12,13 2,6\"/></svg></div>\n          <div class=\"contact-label\">Napisz</div>\n          <div class=\"contact-value\">kontakt@stago.com.pl</div>\n          <div class=\"contact-note\">Odpowiadamy w 24 godziny. Załącz zdjęcia jeśli masz.</div>\n        </a>\n\n        <a href=\"https://maps.app.goo.gl/YehaPostjwupY4zh7\" target=\"_blank\" rel=\"noopener\" class=\"contact-card\">\n          <div class=\"contact-icon\"><svg width=\"36\" height=\"36\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z\"/><circle cx=\"12\" cy=\"10\" r=\"3\"/></svg></div>\n          <div class=\"contact-label\">Przyjedź</div>\n          <div class=\"contact-value\">Jasionka 117</div>\n          <div class=\"contact-note\">28-300 Jędrzejów, woj. świętokrzyskie. Umów wizytę telefonicznie.</div>\n        </a>\n\n      </div>\n    </div>\n  </section>\n\n  <style>\n    .contact-cards-grid .contact-card{min-width:0}\n    .contact-cards-grid .contact-value{overflow-wrap:anywhere}\n    .quote-section .contact-form-grid{gap:48px;align-items:center}\n    .quote-form{order:2;background:var(--white);padding:36px;border:1px solid var(--border);border-top:4px solid var(--accent);border-radius:var(--r);box-shadow:var(--shadow)}\n    .quote-form .eyebrow{text-align:left;margin:0 0 10px}\n    .quote-form .h2{text-align:left;font-size:clamp(1.75rem,3vw,2.2rem);margin:0 0 12px}\n    .quote-intro{color:var(--t2);font-size:.95rem;line-height:1.65;margin-bottom:6px}\n    .quote-field{display:flex;flex-direction:column;gap:7px;font-size:.85rem;font-weight:700}\n    .quote-field input,.quote-field textarea{width:100%}\n    .quote-details{border-block:1px solid var(--border);margin:2px 0}\n    .quote-details summary{cursor:pointer;font-size:.85rem;font-weight:700;padding:14px 0;color:var(--t2)}\n    .quote-details summary span{font-weight:400}\n    .quote-details .quote-field{margin:0 0 16px}\n    .quote-details .quote-field span{font-weight:400;color:var(--t2)}\n    .quote-form .form-consent input[type=\"checkbox\"]{width:18px;height:18px;padding:0;flex-shrink:0}\n    .quote-form .form-consent{align-items:flex-start}\n    .quote-form .form-consent span{font-size:.75rem}\n    .quote-section .quote-form .form-consent a{color:#A82E0E}\n    .quote-form .btn{min-height:54px;font-size:1rem}\n    .quote-section .quote-form .form-note{font-size:.78rem;margin:0}\n    .quote-story{order:1;min-width:0}\n    .quote-story .eyebrow{text-align:left}\n    .quote-story h2{font-size:clamp(1.5rem,3vw,2rem);line-height:1.2;letter-spacing:-.03em;max-width:400px}\n    .quote-story>p:not(.eyebrow){color:var(--t2);margin:16px 0 24px;line-height:1.7}\n    .quote-story figure{margin:0}\n    .quote-story img{width:100%;height:auto;aspect-ratio:16/10;object-fit:cover;object-position:center 75%;border-radius:var(--r-sm)}\n    .quote-story figcaption{font-size:.75rem;color:var(--t2);margin-top:9px}\n    .quote-story .contact-info-list{gap:10px;margin-top:20px}\n    .quote-story .contact-info-list li{font-size:.85rem}\n    @media(max-width:880px){.quote-section{padding:40px 0}.quote-section .contact-form-grid{gap:36px}.quote-form{order:1;padding:26px}.quote-story{order:2}}\n    @media(max-width:480px){.quote-section>.container{padding:0 16px}.quote-form{padding:24px 20px}.quote-form .h2{font-size:1.75rem}.quote-intro{font-size:.9rem}.quote-story{padding:0 8px}}\n  </style>\n  <section class=\"section section-light quote-section\" aria-label=\"Bezpłatna wycena pawilonu\">\n    <div class=\"container\">\n      <div class=\"contact-form-grid\">\n        <form class=\"product-form quote-form\" id=\"contact-form\" data-stago-form aria-labelledby=\"quote-title\">\n          <div>\n            <p class=\"eyebrow\">Bezpłatna wycena</p>\n            <h2 class=\"h2\" id=\"quote-title\">Twój pawilon zaczyna się <span class=\"accent\">od rozmowy.</span></h2>\n            <p class=\"quote-intro\">Zostaw imię i telefon. Oddzwonimy, ustalimy szczegóły i przygotujemy wycenę. Nie musisz jeszcze znać wymiarów.</p>\n          </div>\n          <label class=\"quote-field\" for=\"quote-name\">Imię\n            <input type=\"text\" id=\"quote-name\" name=\"name\" placeholder=\"Jak masz na imię?\" autocomplete=\"given-name\" maxlength=\"100\" required>\n          </label>\n          <label class=\"quote-field\" for=\"quote-phone\">Telefon\n            <input type=\"tel\" id=\"quote-phone\" name=\"phone\" placeholder=\"Numer, pod który oddzwonimy\" autocomplete=\"tel\" inputmode=\"tel\" maxlength=\"30\" required>\n          </label>\n          <details class=\"quote-details\">\n            <summary>Dodaj szczegóły <span>(opcjonalnie)</span></summary>\n            <label class=\"quote-field\" for=\"quote-email\">E-mail <span>Jeśli chcesz podać go już teraz.</span>\n              <input type=\"email\" id=\"quote-email\" name=\"email\" oninvalid=\"this.closest('details').open=true\" placeholder=\"twoj@email.pl\" autocomplete=\"email\" maxlength=\"254\">\n            </label>\n            <label class=\"quote-field\" for=\"quote-message\">Co planujesz? <span>Możesz dopisać przeznaczenie, wymiary lub lokalizację.</span>\n              <textarea id=\"quote-message\" name=\"message\" rows=\"3\" maxlength=\"2000\" placeholder=\"Np. mały pawilon pod kawiarnię w Kielcach\"></textarea>\n            </label>\n          </details>\n          <label class=\"form-consent\"><input type=\"checkbox\" name=\"consent\" required><span>Wyrażam zgodę na przetwarzanie danych osobowych. <a href=\"polityka-prywatnosci.html\" target=\"_blank\" rel=\"noopener\">Polityka prywatności</a></span></label>\n          <button type=\"submit\" class=\"btn btn-primary btn-full\">Poproś o wycenę</button>\n          <p class=\"form-note\">Bezpłatnie i bez zobowiązań.</p>\n        </form>\n        <div class=\"quote-story\">\n          <p class=\"eyebrow\">Bezpośrednio od producenta</p>\n          <h2>Masz pomysł na swoje miejsce? Pomożemy go zbudować.</h2>\n          <p>Sklep, biuro, gastronomia czy własna przestrzeń. Dobierzemy układ, wykończenie i wyposażenie do tego, czego potrzebujesz.</p>\n          <figure>\n            <img src=\"assets/gallery/realizacje/rz21.webp\" alt=\"Grafitowy pawilon STAGO z dużymi przeszkleniami podczas montażu\" width=\"1400\" height=\"1050\" loading=\"lazy\">\n            <figcaption>Jedna z naszych realizacji. Pawilon podczas montażu.</figcaption>\n          </figure>\n          <ul class=\"contact-info-list\">\n            <li><svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" aria-hidden=\"true\"><polyline points=\"20 6 9 17 4 12\"/></svg>Wymiary i układ ustalimy wspólnie</li>\n            <li><svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" aria-hidden=\"true\"><polyline points=\"20 6 9 17 4 12\"/></svg>Wycena z transportem i montażem</li>\n          </ul>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <section class=\"section\">\n    <div class=\"container\">\n      <p class=\"eyebrow\">Gdzie nas znajdziesz</p>\n      <h2 class=\"h2\">Zakład produkcyjny — Jasionka 117</h2>\n      <p class=\"section-sub\">Przyjedź i zobacz na żywo, jak powstają nasze pawilony. Wielu klientów odwiedza nas przed zamówieniem, by sprawdzić jakość wykonania i omówić szczegóły.</p>\n      <div class=\"contact-map-wrap\">\n        <iframe src=\"https://www.google.com/maps?q=STAGO+Jasionka+117,+28-300+Jędrzejów&output=embed&z=16\" width=\"100%\" height=\"450\" style=\"border:0;border-radius:var(--r)\" allowfullscreen=\"\" loading=\"lazy\" referrerpolicy=\"no-referrer-when-downgrade\" title=\"STAGO — Jasionka 117, Jędrzejów\"></iframe>\n      </div>\n      <div class=\"contact-address-grid\">\n        <div>\n          <strong>Adres</strong>\n          <p>Jasionka 117<br>28-300 Jędrzejów<br>woj. świętokrzyskie</p>\n        </div>\n        <div>\n          <strong>Godziny otwarcia</strong>\n          <p>Pon-Pt: 7:00 - 15:00<br>Sob-Niedz: zamknięte</p>\n        </div>\n        <div>\n          <strong>Obsługujemy</strong>\n          <p>Cała Polska. Kielce, Kraków, Radom, Częstochowa, Katowice, Łódź, Warszawa — i wszędzie tam, gdzie jeździ naczepa.</p>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <section class=\"section section-dark\">\n    <div class=\"container\" style=\"text-align:center\">\n      <p class=\"eyebrow\">Wolisz online?</p>\n      <h2 class=\"h2\">Sprawdź konfigurator <span class=\"accent\">i zaplanuj swoje miejsce.</span></h2>\n      <p style=\"color:var(--t-light2);font-size:1.05rem;max-width:600px;margin:16px auto 32px\">Wybierz typ, rozmiar i wykończenie. Resztą zajmiemy się my — dostaniesz wizualizację i ofertę dopasowaną do Twojego pomysłu.</p>\n      <div style=\"display:flex;gap:16px;justify-content:center;flex-wrap:wrap\">\n        <a href=\"konfigurator.html\" class=\"btn btn-primary btn-lg\">Otwórz konfigurator</a>\n        <a href=\"modele.html\" class=\"btn btn-outline-light\">Zobacz wszystkie modele</a>\n      </div>\n    </div>\n  </section>",
  "ldjson": "<script type=\"application/ld+json\">\n  {\n    \"@context\": \"https://schema.org\",\n    \"@type\": \"LocalBusiness\",\n    \"name\": \"STAGO - producent pawilonów modułowych\",\n    \"image\": \"https://stago.com.pl/assets/logo.png\",\n    \"url\": \"https://stago.com.pl\",\n    \"telephone\": \"+48509508210\",\n    \"email\": \"kontakt@stago.com.pl\",\n    \"address\": {\n      \"@type\": \"PostalAddress\",\n      \"streetAddress\": \"Jasionka 117\",\n      \"addressLocality\": \"Jędrzejów\",\n      \"postalCode\": \"28-300\",\n      \"addressRegion\": \"świętokrzyskie\",\n      \"addressCountry\": \"PL\"\n    },\n    \"geo\": {\n      \"@type\": \"GeoCoordinates\",\n      \"latitude\": \"50.6424\",\n      \"longitude\": \"20.3024\"\n    },\n    \"openingHoursSpecification\": [\n      {\"@type\": \"OpeningHoursSpecification\", \"dayOfWeek\": [\"Monday\",\"Tuesday\",\"Wednesday\",\"Thursday\",\"Friday\"], \"opens\": \"07:00\", \"closes\": \"15:00\"}\n    ],\n    \"priceRange\": \"$$\",\n    \"aggregateRating\": {\n      \"@type\": \"AggregateRating\",\n      \"ratingValue\": \"{{googleRating.ratingValue}}\",\n      \"reviewCount\": \"{{googleRating.reviewCount}}\",\n      \"bestRating\": \"5\"\n    },\n    \"areaServed\": [\n      {\"@type\": \"Country\", \"name\": \"Polska\"},\n      {\"@type\": \"Country\", \"name\": \"Deutschland\"},\n      {\"@type\": \"Country\", \"name\": \"Česko\"},\n      {\"@type\": \"Country\", \"name\": \"Slovensko\"}\n    ],\n    \"sameAs\": [\n      \"https://www.facebook.com/share/1C5K2yNMj9/?mibextid=wwXIfr\",\n      \"https://instagram.com/stago_pawilony_modulowe\",\n      \"https://www.tiktok.com/@stago_pawilony_modulowe\"\n    ]\n  }\n  </script>\n  <script type=\"application/ld+json\">\n  {\n    \"@context\": \"https://schema.org\",\n    \"@type\": \"BreadcrumbList\",\n    \"itemListElement\": [\n      {\"@type\": \"ListItem\", \"position\": 1, \"name\": \"Strona główna\", \"item\": \"https://stago.com.pl/\"},\n   